#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to `secrets.h` and fill in your own values.
// `secrets.h` is listed in .gitignore and must never be committed.

// The Wi-Fi network is not set here: the admin sets it from the app over
// Bluetooth, and the device keeps it in flash.

// Edge Function URL, without a trailing slash.
#define VERIFY_ENDPOINT "https://<project-ref>.functions.supabase.co/verify-access"

// Per-device token: the same value as the Edge Function's DEVICE_TOKEN secret.
// It is NOT a Supabase key. Generate one with: openssl rand -hex 32
#define DEVICE_TOKEN    "generate-with-openssl-rand-hex-32"

// GTS Root R4, the self-signed root that anchors *.functions.supabase.co.
// Valid until 2036. It is public, so it ships in the example as is.
// To check it: openssl s_client -showcerts -connect <host>:443
#define SUPABASE_ROOT_CA \
  "-----BEGIN CERTIFICATE-----\n" \
